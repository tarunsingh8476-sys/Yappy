# Database Configuration (Embedded file H2 by default; or optional PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_community
DB_USERNAME=smartuser
DB_PASSWORD=smartpassword

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (formerly Sendinblue) Transactional Email
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_account_login_email
BREVO_SMTP_KEY=xsmtpsib-your-smtp-master-key
BREVO_SENDER_NAME=Smart Community
BREVO_SENDER_EMAIL=your_verified_sender@domain.com

# JWT Security
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ML Moderation Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google reCAPTCHA v3
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key

# OAuth2 Providers
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=12MB
